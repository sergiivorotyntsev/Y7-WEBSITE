{
  "title": "\u0427\u0430\u0441\u0442\u043e \u0437\u0430\u0434\u0430\u0432\u0430\u0435\u043c\u044b\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b",
  "subtitle": "\u0412\u0441\u0451, \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0437\u043d\u0430\u0442\u044c \u043e \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u043a\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0441 Y7 Logistics.",
  "categories": [
    {
      "name": "\u041d\u0430\u0447\u0430\u043b\u043e \u0440\u0430\u0431\u043e\u0442\u044b",
      "items": [
        {
          "q": "\u041a\u0430\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u043a\u0430 \u0430\u0432\u0442\u043e?",
          "a": "\u041c\u044b \u043f\u043e\u0434\u0431\u0438\u0440\u0430\u0435\u043c \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0438 \u0437\u0430\u0441\u0442\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u0447\u0438\u043a\u043e\u0432 \u0447\u0435\u0440\u0435\u0437 Central Dispatch. \u0412\u044b \u0437\u0430\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0435 \u043a\u043e\u0442\u0438\u0440\u043e\u0432\u043a\u0443, \u043c\u044b \u043d\u0430\u0445\u043e\u0434\u0438\u043c \u043b\u0443\u0447\u0448\u0435\u0433\u043e \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u0447\u0438\u043a\u0430, \u043e\u043d\u0438 \u0437\u0430\u0431\u0438\u0440\u0430\u044e\u0442 \u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u0432\u0430\u0448 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u043e\u0442 \u0434\u0432\u0435\u0440\u0438 \u0434\u043e \u0434\u0432\u0435\u0440\u0438."
        },
        {
          "q": "\u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430?",
          "a": "1\u20133 \u0434\u043d\u044f \u0434\u043b\u044f \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432 \u0434\u043e 500 \u043c\u0438\u043b\u044c, 3\u20137 \u0434\u043d\u0435\u0439 \u043f\u043e \u0432\u0441\u0435\u0439 \u0441\u0442\u0440\u0430\u043d\u0435. \u0421\u0440\u043e\u043a\u0438 \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u2014 \u043f\u043e\u0433\u043e\u0434\u0430, \u0442\u0440\u0430\u0444\u0438\u043a \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u0447\u0438\u043a\u043e\u0432 \u043c\u043e\u0433\u0443\u0442 \u0432\u043b\u0438\u044f\u0442\u044c \u043d\u0430 \u0442\u0440\u0430\u043d\u0437\u0438\u0442."
        },
        {
          "q": "\u041a\u0430\u043a\u0430\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043d\u0443\u0436\u043d\u0430 \u0434\u043b\u044f \u043a\u043e\u0442\u0438\u0440\u043e\u0432\u043a\u0438?",
          "a": "\u0413\u043e\u0434/\u043c\u0430\u0440\u043a\u0430/\u043c\u043e\u0434\u0435\u043b\u044c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0438\u043b\u0438 VIN, \u0433\u043e\u0440\u043e\u0434\u0430 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438 \u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0434\u0430\u0442\u044b. \u0414\u043b\u044f \u0430\u0443\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0435\u0439 \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u043d\u043e\u043c\u0435\u0440 \u043b\u043e\u0442\u0430."
        },
        {
          "q": "\u041d\u0443\u0436\u043d\u043e \u043b\u0438 \u043c\u043e\u0451 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043f\u0440\u0438 \u0437\u0430\u0431\u043e\u0440\u0435/\u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0435?",
          "a": "\u041a\u0442\u043e-\u0442\u043e \u0441\u0442\u0430\u0440\u0448\u0435 18 \u043b\u0435\u0442 \u0434\u043e\u043b\u0436\u0435\u043d \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0434\u043b\u044f \u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0438 \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u043e\u0439 \u043d\u0430\u043a\u043b\u0430\u0434\u043d\u043e\u0439 (BOL) \u043f\u0440\u0438 \u0437\u0430\u0431\u043e\u0440\u0435 \u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0435."
        }
      ]
    },
    {
      "name": "\u0426\u0435\u043d\u044b \u0438 \u043e\u043f\u043b\u0430\u0442\u0430",
      "items": [
        {
          "q": "\u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u043e\u0438\u0442 \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u043a\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f?",
          "a": "\u0426\u0435\u043d\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u0440\u0430\u0437\u043c\u0435\u0440\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f, \u0442\u0438\u043f\u0430 \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u043a\u0438 (\u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0439 \u0438\u043b\u0438 \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u0439 \u0442\u0440\u0435\u0439\u043b\u0435\u0440) \u0438 \u0440\u044b\u043d\u043e\u0447\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u0439. \u0417\u0430\u043f\u0440\u043e\u0441\u0438\u0442\u0435 \u043a\u043e\u0442\u0438\u0440\u043e\u0432\u043a\u0443 \u0434\u043b\u044f \u0442\u043e\u0447\u043d\u043e\u0439 \u043e\u0446\u0435\u043d\u043a\u0438."
        },
        {
          "q": "\u0415\u0441\u0442\u044c \u043b\u0438 \u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u043f\u043b\u0430\u0442\u0435\u0436\u0438?",
          "a": "\u041d\u0435\u0442. \u0412\u0430\u0448\u0430 \u043a\u043e\u0442\u0438\u0440\u043e\u0432\u043a\u0430 \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0432\u0441\u0451. \u0414\u043b\u044f \u043d\u0435\u0438\u0441\u043f\u0440\u0430\u0432\u043d\u044b\u0445 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0435\u0439 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043f\u043b\u0430\u0442\u0430 $100\u2013300, \u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0441\u043e\u043e\u0431\u0449\u0430\u0435\u0442\u0441\u044f \u0437\u0430\u0440\u0430\u043d\u0435\u0435."
        },
        {
          "q": "\u041a\u0430\u043a\u0438\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u044b \u043e\u043f\u043b\u0430\u0442\u044b \u0432\u044b \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442\u0435?",
          "a": "Zelle, \u0431\u0430\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0434, ACH \u0434\u043b\u044f \u043f\u0440\u0435\u0434\u043e\u043f\u043b\u0430\u0442\u044b. \u041d\u0430\u043b\u0438\u0447\u043d\u044b\u0435 \u0438\u043b\u0438 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0447\u0435\u043a\u0438 \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u0447\u0438\u043a\u0443 \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0435 (COD)."
        },
        {
          "q": "\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043b\u0438 \u0437\u0430\u043b\u043e\u0433?",
          "a": "\u0417\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0441\u043f\u043e\u0441\u043e\u0431\u0430 \u043e\u043f\u043b\u0430\u0442\u044b. \u041f\u0440\u0435\u0434\u043e\u043f\u043b\u0430\u0447\u0435\u043d\u043d\u044b\u0435 \u0437\u0430\u043a\u0430\u0437\u044b \u043e\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0435\u0440\u0435\u0434 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u043e\u0439. \u0417\u0430\u043a\u0430\u0437\u044b COD \u043c\u043e\u0433\u0443\u0442 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u0442\u044c \u0437\u0430\u043b\u043e\u0433 \u0434\u043b\u044f \u0431\u0440\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f."
        }
      ]
    },
    {
      "name": "\u0412\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u043a\u0438",
      "items": [
        {
          "q": "\u041a\u0430\u043a \u043e\u0442\u0441\u043b\u0435\u0434\u0438\u0442\u044c \u043c\u043e\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c?",
          "a": "\u0427\u0435\u0440\u0435\u0437 \u043d\u0430\u0448 \u043a\u043b\u0438\u0435\u043d\u0442\u0441\u043a\u0438\u0439 \u043f\u043e\u0440\u0442\u0430\u043b, Telegram-\u0431\u043e\u0442 (@y7dispatch_bot) \u0438\u043b\u0438 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u043f\u043e \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u0447\u0442\u0435 \u043d\u0430 \u043a\u0430\u0436\u0434\u043e\u043c \u044d\u0442\u0430\u043f\u0435."
        },
        {
          "q": "\u041a\u0430\u043a\u0430\u044f \u0441\u0442\u0440\u0430\u0445\u043e\u0432\u043a\u0430 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0430?",
          "a": "\u0412\u0441\u0435 \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u0447\u0438\u043a\u0438 \u0438\u043c\u0435\u044e\u0442 \u043c\u0438\u043d\u0438\u043c\u0443\u043c $100,000 \u0441\u0442\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u0438\u044f \u0433\u0440\u0443\u0437\u0430 \u043f\u043e \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f\u043c FMCSA. \u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0438\u043c\u0435\u044e\u0442 $250,000+."
        },
        {
          "q": "\u0427\u0442\u043e \u0435\u0441\u043b\u0438 \u043c\u043e\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0451\u043d?",
          "a": "\u041e\u0442\u043c\u0435\u0442\u044c\u0442\u0435 \u043b\u044e\u0431\u044b\u0435 \u043d\u043e\u0432\u044b\u0435 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u0432 BOL \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0435. \u041f\u043e\u0434\u0430\u0439\u0442\u0435 \u043f\u0440\u0435\u0442\u0435\u043d\u0437\u0438\u044e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 24 \u0447\u0430\u0441\u043e\u0432 \u0441 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044f\u043c\u0438. \u041c\u044b \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u043c \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u043e \u0441\u0442\u0440\u0430\u0445\u043e\u0432\u043a\u043e\u0439 \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u0447\u0438\u043a\u0430."
        },
        {
          "q": "\u0427\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u0430\u044f \u043d\u0430\u043a\u043b\u0430\u0434\u043d\u0430\u044f (BOL)?",
          "a": "\u042e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442, \u0444\u0438\u043a\u0441\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u043f\u0440\u0438 \u0437\u0430\u0431\u043e\u0440\u0435 \u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0435. \u0412\u0441\u0435\u0433\u0434\u0430 \u0432\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0439\u0442\u0435 \u0438 \u043f\u043e\u0434\u043f\u0438\u0441\u044b\u0432\u0430\u0439\u0442\u0435 \u0435\u0433\u043e."
        }
      ]
    },
    {
      "name": "\u0410\u0443\u043a\u0446\u0438\u043e\u043d\u044b \u0438 \u043f\u043e\u0440\u0442\u044b",
      "items": [
        {
          "q": "\u0412\u044b \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u0441 IAAI, Copart, Manheim?",
          "a": "\u0414\u0430. \u041c\u044b \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u043c\u0441\u044f \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u043c\u0438, \u0432\u044b\u043f\u0443\u0441\u043a\u043e\u043c \u043b\u043e\u0442\u043e\u0432 \u0438 \u0432\u0441\u0435\u043c\u0438 \u0430\u0443\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u043c\u0438 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u043c\u0438."
        },
        {
          "q": "\u0427\u0442\u043e \u0442\u0430\u043a\u043e\u0435 gate pass?",
