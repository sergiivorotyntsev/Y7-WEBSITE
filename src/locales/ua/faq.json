        }
      ]
    },
    {
      "name": "\u0414\u043b\u044f \u0434\u0438\u043b\u0435\u0440\u0456\u0432 \u0442\u0430 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0435\u0440\u0456\u0432",
      "items": [
        {
          "q": "\u0427\u0438 \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u0454\u0442\u0435 \u0437\u043d\u0438\u0436\u043a\u0438 \u043d\u0430 \u043e\u0431\u0441\u044f\u0433?",
          "a": "\u0422\u0430\u043a. \u0414\u0438\u043b\u0435\u0440\u0438 \u0442\u0430 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0435\u0440\u0438, \u0449\u043e \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442\u044c 10+ \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u0456\u0432 \u043d\u0430 \u043c\u0456\u0441\u044f\u0446\u044c, \u043e\u0442\u0440\u0438\u043c\u0443\u044e\u0442\u044c \u0456\u043d\u0434\u0438\u0432\u0456\u0434\u0443\u0430\u043b\u044c\u043d\u0456 \u0446\u0456\u043d\u0438 \u0437 \u0432\u0438\u0434\u0456\u043b\u0435\u043d\u0438\u043c \u0434\u0438\u0441\u043f\u0435\u0442\u0447\u0435\u0440\u043e\u043c."
        },
        {
          "q": "\u042f\u043a\u0430 \u0432\u0430\u0448\u0430 \u043f\u0440\u043e\u0437\u043e\u0440\u0430 \u043c\u043e\u0434\u0435\u043b\u044c \u0446\u0456\u043d\u043e\u0443\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f?",
          "a": "\u0414\u043b\u044f \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0435\u0440\u0456\u0432: \u0441\u0442\u0430\u0432\u043a\u0430 \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0430 \u0437\u0430 \u0441\u043e\u0431\u0456\u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044e + \u043d\u0430\u0448\u0430 \u0444\u0456\u043a\u0441\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043c\u0456\u0441\u0456\u044f. \u0416\u043e\u0434\u043d\u0438\u0445 \u043d\u0430\u0446\u0456\u043d\u043e\u043a \u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442."
        },
        {
          "q": "\u0427\u0438 \u043c\u043e\u0436\u0443 \u044f \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0432\u0438\u0434\u0456\u043b\u0435\u043d\u043e\u0433\u043e \u0434\u0438\u0441\u043f\u0435\u0442\u0447\u0435\u0440\u0430?",
          "a": "\u0422\u0430\u043a, \u0434\u043b\u044f \u043e\u043f\u0442\u043e\u0432\u0438\u0445 \u043a\u043b\u0456\u0454\u043d\u0442\u0456\u0432 (10+ \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u0456\u0432 \u043d\u0430 \u043c\u0456\u0441\u044f\u0446\u044c). \u041e\u0434\u043d\u0430 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u0430 \u043e\u0441\u043e\u0431\u0430 \u0434\u043b\u044f \u0432\u0441\u0456\u0445 \u0432\u0430\u0448\u0438\u0445 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044c."
        }
      ]
    },
    {
      "name": "\u041a\u043e\u043c\u0443\u043d\u0456\u043a\u0430\u0446\u0456\u044f \u0442\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438",
      "items": [
        {
          "q": "\u042f\u043a \u0437\u0432'\u044f\u0437\u0430\u0442\u0438\u0441\u044f \u0437 Y7, \u044f\u043a\u0449\u043e \u044f \u043d\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u044e\u0441\u044f \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u0438\u043c\u0438 \u0434\u0437\u0432\u0456\u043d\u043a\u0430\u043c\u0438?",
          "a": "\u041f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0430 \u043a\u043b\u0456\u0454\u043d\u0442\u0456\u0432 Y7 \u043f\u0440\u0430\u0446\u044e\u0454 \u0432 digital-first \u0440\u0435\u0436\u0438\u043c\u0456. \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0432'\u044f\u0437\u0430\u0442\u0438\u0441\u044f \u0437 \u043d\u0430\u043c\u0438 \u0447\u0435\u0440\u0435\u0437 \u043a\u043b\u0456\u0454\u043d\u0442\u0441\u044c\u043a\u0438\u0439 \u043f\u043e\u0440\u0442\u0430\u043b, Telegram-\u0431\u043e\u0442 (@y7dispatch_bot) \u0430\u0431\u043e email (info@y7agency.com \u0434\u043b\u044f \u043d\u043e\u0432\u0438\u0445 \u0437\u0430\u043f\u0438\u0442\u0456\u0432, dispatch@y7agency.com \u0434\u043b\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0445 \u043f\u0435\u0440\u0435\u0432\u0435\u0437\u0435\u043d\u044c). \u041a\u043e\u0436\u0435\u043d \u0437\u0430\u043f\u0438\u0442 \u0444\u0456\u043a\u0441\u0443\u0454\u0442\u044c\u0441\u044f \u043f\u0438\u0441\u044c\u043c\u043e\u0432\u043e, \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438 \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0443\u044e\u0442\u044c\u0441\u044f, \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0446\u0456\u044f \u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u044c \u0437\u0440\u0443\u0447\u043d\u0430. \u041d\u0430\u044f\u0432\u043d\u0456 \u043a\u043b\u0456\u0454\u043d\u0442\u0438 \u043c\u0430\u044e\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f 24/7 \u0447\u0435\u0440\u0435\u0437 \u043f\u043e\u0440\u0442\u0430\u043b \u0456 Telegram-\u0431\u043e\u0442 \u0437 \u0442\u0435\u0440\u043c\u0456\u043d\u043e\u0432\u0438\u0445 \u043f\u0438\u0442\u0430\u043d\u044c \u043f\u0435\u0440\u0435\u0432\u0435\u0437\u0435\u043d\u044c."
        },
        {
          "q": "\u042f\u043a \u0432\u043e\u0434\u0456\u0439 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0443\u0454 \u0437\u0456 \u043c\u043d\u043e\u044e \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0443?",
          "a": "\u041f\u0456\u0441\u043b\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0430 \u043f\u0440\u044f\u043c\u0438\u0439 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u0432\u043e\u0434\u0456\u044f \u0437'\u044f\u0432\u043b\u044f\u0454\u0442\u044c\u0441\u044f \u0443 \u0432\u0430\u0448\u043e\u043c\u0443 \u043f\u043e\u0440\u0442\u0430\u043b\u0456. \u0412\u043e\u0434\u0456\u0439 \u0437\u0430\u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443\u0454 \u0437\u0430 1\u20134 \u0433\u043e\u0434\u0438\u043d\u0438 \u0434\u043e \u0437\u0430\u0431\u043e\u0440\u0443 \u0442\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438, \u0449\u043e\u0431 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438 \u0447\u0430\u0441, \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0456 \u0442\u043e\u0447\u043a\u0443 \u0440\u043e\u0437\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f. \u0426\u0435 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 \u0434\u043b\u044f \u0432\u0441\u0456\u0454\u0457 \u0433\u0430\u043b\u0443\u0437\u0456 \u2014 \u0444\u0456\u0437\u0438\u0447\u043d\u0430 \u043b\u043e\u0433\u0456\u0441\u0442\u0438\u043a\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0432\u0438\u043c\u0430\u0433\u0430\u0454 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u043e\u0457 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0446\u0456\u0457 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0447\u0430\u0441\u0456, \u044f\u043a\u0443 \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0437\u0430\u043c\u0456\u043d\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442\u043e\u043c."
        },
        {
          "q": "\u042f\u043a \u044f \u043e\u0442\u0440\u0438\u043c\u0430\u044e \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 BOL?",
          "a": "\u0423\u0441\u0456 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438 \u043e\u0431\u0440\u043e\u0431\u043b\u044f\u044e\u0442\u044c\u0441\u044f \u0432 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u043c\u0443 \u0432\u0438\u0433\u043b\u044f\u0434\u0456. BOL \u043f\u0456\u0434\u043f\u0438\u0441\u0443\u0454\u0442\u044c\u0441\u044f \u043f\u0440\u0438 \u0437\u0430\u0431\u043e\u0440\u0456 \u0442\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u0446\u0456 (\u043f\u0430\u043f\u0435\u0440\u043e\u0432\u0438\u0439 \u0430\u0431\u043e \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0438\u0439 \u043f\u0456\u0434\u043f\u0438\u0441 \u2014 \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0430), \u043f\u043e\u0442\u0456\u043c \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c 24 \u0433\u043e\u0434\u0438\u043d \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454\u0442\u044c\u0441\u044f \u0434\u043e \u0432\u0430\u0448\u043e\u0433\u043e \u043f\u043e\u0440\u0442\u0430\u043b\u0443. \u0414\u043e\u0434\u0430\u044e\u0442\u044c\u0441\u044f \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0456\u0457 \u0441\u0442\u0430\u043d\u0443 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u043d\u0430 \u043e\u0431\u043e\u0445 \u0435\u0442\u0430\u043f\u0430\u0445. \u0406\u043d\u0432\u043e\u0439\u0441\u0438, \u0447\u0435\u043a\u0438 \u0442\u0430 \u0441\u0442\u0440\u0430\u0445\u043e\u0432\u0456 \u0434\u043e\u0432\u0456\u0434\u043a\u0438 \u043d\u0430\u0434\u0445\u043e\u0434\u044f\u0442\u044c \u043d\u0430 email, \u0430 \u0442\u0430\u043a\u043e\u0436 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0442\u044c\u0441\u044f \u0432 \u043f\u043e\u0440\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u0443."
        }
      ]
    }
  ]
