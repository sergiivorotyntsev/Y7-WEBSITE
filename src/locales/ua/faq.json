{
  "title": "\u041f\u043e\u0448\u0438\u0440\u0435\u043d\u0456 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f",
  "subtitle": "\u0412\u0441\u0435, \u0449\u043e \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0437\u043d\u0430\u0442\u0438 \u043f\u0440\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0437\u0435\u043d\u043d\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u0437 Y7 Logistics.",
  "categories": [
    {
      "name": "\u041f\u043e\u0447\u0430\u0442\u043e\u043a \u0440\u043e\u0431\u043e\u0442\u0438",
      "items": [
        {
          "q": "\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 \u043f\u0435\u0440\u0435\u0432\u0435\u0437\u0435\u043d\u043d\u044f \u0430\u0432\u0442\u043e?",
          "a": "\u041c\u0438 \u043f\u0456\u0434\u0431\u0438\u0440\u0430\u0454\u043c\u043e \u043b\u0456\u0446\u0435\u043d\u0437\u043e\u0432\u0430\u043d\u0438\u0445 \u0442\u0430 \u0437\u0430\u0441\u0442\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0456\u0432 \u0447\u0435\u0440\u0435\u0437 Central Dispatch. \u0412\u0438 \u0437\u0430\u043f\u0438\u0442\u0443\u0454\u0442\u0435 \u043a\u043e\u0442\u0438\u0440\u0443\u0432\u0430\u043d\u043d\u044f, \u043c\u0438 \u0437\u043d\u0430\u0445\u043e\u0434\u0438\u043c\u043e \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0430, \u0432\u043e\u043d\u0438 \u0437\u0430\u0431\u0438\u0440\u0430\u044e\u0442\u044c \u0442\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442\u044c \u0432\u0430\u0448 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u0432\u0456\u0434 \u0434\u0432\u0435\u0440\u0435\u0439 \u0434\u043e \u0434\u0432\u0435\u0440\u0435\u0439."
        },
        {
          "q": "\u0421\u043a\u0456\u043b\u044c\u043a\u0438 \u0447\u0430\u0441\u0443 \u0437\u0430\u0439\u043c\u0430\u0454 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430?",
          "a": "1\u20133 \u0434\u043d\u0456 \u0434\u043b\u044f \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0456\u0432 \u0434\u043e 500 \u043c\u0438\u043b\u044c, 3\u20137 \u0434\u043d\u0456\u0432 \u043f\u043e \u0432\u0441\u0456\u0439 \u043a\u0440\u0430\u0457\u043d\u0456. \u0422\u0435\u0440\u043c\u0456\u043d\u0438 \u043e\u0440\u0456\u0454\u043d\u0442\u043e\u0432\u043d\u0456 \u2014 \u043f\u043e\u0433\u043e\u0434\u0430, \u0442\u0440\u0430\u0444\u0456\u043a \u0442\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0456\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0456\u0432 \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u043f\u043b\u0438\u0432\u0430\u0442\u0438 \u043d\u0430 \u0442\u0440\u0430\u043d\u0437\u0438\u0442."
        },
        {
          "q": "\u042f\u043a\u0430 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0430 \u0434\u043b\u044f \u043a\u043e\u0442\u0438\u0440\u0443\u0432\u0430\u043d\u043d\u044f?",
          "a": "\u0420\u0456\u043a/\u043c\u0430\u0440\u043a\u0430/\u043c\u043e\u0434\u0435\u043b\u044c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u0430\u0431\u043e VIN, \u043c\u0456\u0441\u0442\u0430 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0442\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438, \u0430 \u0442\u0430\u043a\u043e\u0436 \u0431\u0430\u0436\u0430\u043d\u0456 \u0434\u0430\u0442\u0438. \u0414\u043b\u044f \u0430\u0443\u043a\u0446\u0456\u043e\u043d\u043d\u0438\u0445 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u0456\u0432 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u0454 \u043d\u043e\u043c\u0435\u0440 \u043b\u043e\u0442\u0443."
        },
        {
          "q": "\u0427\u0438 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0430 \u043c\u043e\u044f \u043f\u0440\u0438\u0441\u0443\u0442\u043d\u0456\u0441\u0442\u044c \u043f\u0440\u0438 \u0437\u0430\u0431\u043e\u0440\u0456/\u0434\u043e\u0441\u0442\u0430\u0432\u0446\u0456?",
          "a": "\u0425\u0442\u043e\u0441\u044c \u0441\u0442\u0430\u0440\u0448\u0435 18 \u0440\u043e\u043a\u0456\u0432 \u043f\u043e\u0432\u0438\u043d\u0435\u043d \u0431\u0443\u0442\u0438 \u043f\u0440\u0438\u0441\u0443\u0442\u043d\u0456\u043c \u0434\u043b\u044f \u043e\u0433\u043b\u044f\u0434\u0443 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u0442\u0430 \u043f\u0456\u0434\u043f\u0438\u0441\u0430\u043d\u043d\u044f \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u043e\u0457 \u043d\u0430\u043a\u043b\u0430\u0434\u043d\u043e\u0457 (BOL) \u043f\u0440\u0438 \u0437\u0430\u0431\u043e\u0440\u0456 \u0442\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u0446\u0456."
        }
      ]
    },
    {
      "name": "\u0426\u0456\u043d\u0438 \u0442\u0430 \u043e\u043f\u043b\u0430\u0442\u0430",
      "items": [
        {
          "q": "\u0421\u043a\u0456\u043b\u044c\u043a\u0438 \u043a\u043e\u0448\u0442\u0443\u0454 \u043f\u0435\u0440\u0435\u0432\u0435\u0437\u0435\u043d\u043d\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f?",
          "a": "\u0426\u0456\u043d\u0430 \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u0432\u0456\u0434\u0441\u0442\u0430\u043d\u0456, \u0440\u043e\u0437\u043c\u0456\u0440\u0443 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f, \u0442\u0438\u043f\u0443 \u043f\u0435\u0440\u0435\u0432\u0435\u0437\u0435\u043d\u043d\u044f (\u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438\u0439 \u0447\u0438 \u0437\u0430\u043a\u0440\u0438\u0442\u0438\u0439 \u0442\u0440\u0435\u0439\u043b\u0435\u0440) \u0442\u0430 \u0440\u0438\u043d\u043a\u043e\u0432\u0438\u0445 \u0443\u043c\u043e\u0432. \u0417\u0430\u043f\u0438\u0442\u0430\u0439\u0442\u0435 \u043a\u043e\u0442\u0438\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0434\u043b\u044f \u0442\u043e\u0447\u043d\u043e\u0457 \u043e\u0446\u0456\u043d\u043a\u0438."
        },
        {
          "q": "\u0427\u0438 \u0454 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u043f\u043b\u0430\u0442\u0435\u0436\u0456?",
          "a": "\u041d\u0456. \u0412\u0430\u0448\u0435 \u043a\u043e\u0442\u0438\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u043a\u043b\u044e\u0447\u0430\u0454 \u0432\u0441\u0435. \u0414\u043b\u044f \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0438\u0445 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u0456\u0432 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0430 \u043f\u043b\u0430\u0442\u0430 $100\u2013300, \u043f\u0440\u043e \u044f\u043a\u0443 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u044f\u0454\u0442\u044c\u0441\u044f \u0437\u0430\u0437\u0434\u0430\u043b\u0435\u0433\u0456\u0434\u044c."
        },
        {
          "q": "\u042f\u043a\u0456 \u0441\u043f\u043e\u0441\u043e\u0431\u0438 \u043e\u043f\u043b\u0430\u0442\u0438 \u0432\u0438 \u043f\u0440\u0438\u0439\u043c\u0430\u0454\u0442\u0435?",
          "a": "Zelle, \u0431\u0430\u043d\u043a\u0456\u0432\u0441\u044c\u043a\u0438\u0439 \u043f\u0435\u0440\u0435\u043a\u0430\u0437, ACH \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0434\u043e\u043f\u043b\u0430\u0442\u0438. \u0413\u043e\u0442\u0456\u0432\u043a\u0430 \u0430\u0431\u043e \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u043e\u0432\u0430\u043d\u0456 \u043a\u043e\u0448\u0442\u0438 \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0443 \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u0446\u0456 (COD)."
        },
        {
          "q": "\u0427\u0438 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u0430?",
          "a": "\u0417\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u0441\u043f\u043e\u0441\u043e\u0431\u0443 \u043e\u043f\u043b\u0430\u0442\u0438. \u041f\u0435\u0440\u0435\u0434\u043e\u043f\u043b\u0430\u0447\u0435\u043d\u0456 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043e\u043f\u043b\u0430\u0447\u0443\u044e\u0442\u044c\u0441\u044f \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u043f\u0435\u0440\u0435\u0434 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043a\u043e\u044e. \u0417\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f COD \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u0438\u043c\u0430\u0433\u0430\u0442\u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u0443 \u0434\u043b\u044f \u0431\u0440\u043e\u043d\u044e\u0432\u0430\u043d\u043d\u044f."
        }
      ]
    },
    {
      "name": "\u041f\u0456\u0434 \u0447\u0430\u0441 \u043f\u0435\u0440\u0435\u0432\u0435\u0437\u0435\u043d\u043d\u044f",
      "items": [
        {
          "q": "\u042f\u043a \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0438\u0442\u0438 \u043c\u0456\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c?",
          "a": "\u0427\u0435\u0440\u0435\u0437 \u043d\u0430\u0448 \u043a\u043b\u0456\u0454\u043d\u0442\u0441\u044c\u043a\u0438\u0439 \u043f\u043e\u0440\u0442\u0430\u043b, Telegram-\u0431\u043e\u0442 (@y7dispatch_bot) \u0430\u0431\u043e \u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u044e \u043f\u043e\u0448\u0442\u043e\u044e \u043d\u0430 \u043a\u043e\u0436\u043d\u043e\u043c\u0443 \u0435\u0442\u0430\u043f\u0456."
        },
        {
          "q": "\u042f\u043a\u0435 \u0441\u0442\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e?",
          "a": "\u041a\u043e\u0436\u0435\u043d \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a \u0443 \u043d\u0430\u0448\u0456\u0439 \u043c\u0435\u0440\u0435\u0436\u0456 \u043c\u0430\u0454 \u043c\u0456\u043d\u0456\u043c\u0443\u043c $100 000 cargo-\u0441\u0442\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f \u2014 \u0431\u0456\u043b\u044c\u0448\u0456\u0441\u0442\u044c $250 000 \u0442\u0430 \u0432\u0438\u0449\u0435. \u0426\u0435 \u0432\u0438\u043c\u043e\u0433\u0430 Y7 \u0437 \u0432\u0435\u0440\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u0457; \u043c\u0438 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0443\u0454\u043c\u043e \u0430\u043a\u0442\u0438\u0432\u043d\u0435 \u043f\u043e\u043a\u0440\u0438\u0442\u0442\u044f \u0447\u0435\u0440\u0435\u0437 Central Dispatch \u043f\u0435\u0440\u0435\u0434 \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f\u043c \u0431\u0443\u0434\u044c-\u044f\u043a\u043e\u0433\u043e \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f."
        },
        {
          "q": "\u0429\u043e \u044f\u043a\u0449\u043e \u043c\u0456\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u043e?",
          "a": "\u0412\u0456\u0434\u0437\u043d\u0430\u0447\u0442\u0435 \u0431\u0443\u0434\u044c-\u044f\u043a\u0456 \u043d\u043e\u0432\u0456 \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0432 BOL \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u0446\u0456. \u041f\u043e\u0434\u0430\u0439\u0442\u0435 \u043f\u0440\u0435\u0442\u0435\u043d\u0437\u0456\u044e \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c 24 \u0433\u043e\u0434\u0438\u043d \u0437 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0456\u044f\u043c\u0438. \u041c\u0438 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u0454\u043c\u043e \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0443\u0432\u0430\u0442\u0438 \u0437\u0456 \u0441\u0442\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0435\u0440\u0435\u0432\u0456\u0437\u043d\u0438\u043a\u0430."
        },
        {
          "q": "\u0429\u043e \u0442\u0430\u043a\u0435 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u0430 \u043d\u0430\u043a\u043b\u0430\u0434\u043d\u0430 (BOL)?",
          "a": "\u042e\u0440\u0438\u0434\u0438\u0447\u043d\u0438\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442, \u0449\u043e \u0444\u0456\u043a\u0441\u0443\u0454 \u0441\u0442\u0430\u043d \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u043f\u0440\u0438 \u0437\u0430\u0431\u043e\u0440\u0456 \u0442\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u0446\u0456. \u0417\u0430\u0432\u0436\u0434\u0438 \u0443\u0432\u0430\u0436\u043d\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0439\u0442\u0435 \u0442\u0430 \u043f\u0456\u0434\u043f\u0438\u0441\u0443\u0439\u0442\u0435 \u0439\u043e\u0433\u043e."
        }
      ]
    },
    {
      "name": "\u0410\u0443\u043a\u0446\u0456\u043e\u043d\u0438 \u0442\u0430 \u043f\u043e\u0440\u0442\u0438",
      "items": [
        {
          "q": "\u0427\u0438 \u0437\u0430\u0431\u0438\u0440\u0430\u0454\u0442\u0435 \u0437 IAAI, Copart, Manheim?",
          "a": "\u0422\u0430\u043a. \u041c\u0438 \u0437\u0430\u0439\u043c\u0430\u0454\u043c\u043e\u0441\u044c \u043f\u0435\u0440\u0435\u043f\u0443\u0441\u0442\u043a\u0430\u043c\u0438, \u0432\u0438\u043f\u0443\u0441\u043a\u043e\u043c \u043b\u043e\u0442\u0456\u0432 \u0442\u0430 \u0432\u0441\u0456\u043c\u0430 \u0430\u0443\u043a\u0446\u0456\u043e\u043d\u043d\u0438\u043c\u0438 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u043c\u0438."
        },
        {
          "q": "\u0429\u043e \u0442\u0430\u043a\u0435 gate pass?",
          "a": "\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442 \u0432\u0456\u0434 \u0430\u0443\u043a\u0446\u0456\u043e\u043d\u0443, \u0449\u043e \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0432\u0438\u043f\u0443\u0441\u043a \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f. \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0439\u043e\u0433\u043e \u0447\u0435\u0440\u0435\u0437 \u043d\u0430\u0448 \u043f\u043e\u0440\u0442\u0430\u043b \u0430\u0431\u043e Telegram-\u0431\u043e\u0442."
