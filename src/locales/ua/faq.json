        {
          "q": "\u0412 \u044f\u043a\u0456 \u043f\u043e\u0440\u0442\u0438 \u0421\u0428\u0410 \u0432\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0454\u0442\u0435?",
          "a": "Newark NJ, Houston TX, Savannah GA, Baltimore MD, Los Angeles CA, Jacksonville FL \u0442\u0430 \u0456\u043d\u0448\u0456."
