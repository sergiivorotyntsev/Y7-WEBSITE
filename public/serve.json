{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/portal/**", "destination": "/index.html" },
    { "source": "/:lang/portal/**", "destination": "/index.html" },
    { "source": "/agreement/**", "destination": "/index.html" },
    { "source": "/:lang/agreement/**", "destination": "/index.html" },
    { "source": "/:lang/quote/**", "destination": "/index.html" },
    { "source": "/ports/**", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "**/*.@(html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "**/*.@(js|css|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "**/*.@(svg|jpg|jpeg|png|webp|avif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
